{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["components/**/*.tsx", "lib/**/*.ts", "scripts/render-button.tsx"]
}
